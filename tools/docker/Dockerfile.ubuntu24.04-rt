# The Occlum runtime is taken from the patched Occlum development image, which
# builds Occlum from the 0.31.0-dev branch of the sk13/occlum fork (see
# Dockerfile.ubuntu24.04), instead of the upstream occlum-runtime package
ARG OCCLUM_DEV_IMAGE=docker.io/sk13sk13/occlum:sk13-ubuntu24.04
FROM ${OCCLUM_DEV_IMAGE} AS occlum-dev

# The versions of the SGX packages that the runtime needs, as installed in the
# development image
FROM occlum-dev AS sgx-packages
RUN dpkg-query -W -f='${Package}=${Version}\n' \
        libsgx-urts \
        libsgx-enclave-common libsgx-ae-pce \
        libsgx-ae-qe3 libsgx-ae-id-enclave libsgx-ae-qve libsgx-dcap-ql \
        libsgx-pce-logic libsgx-qe3-logic libsgx-dcap-default-qpl \
        libsgx-dcap-quote-verify > /sgx-packages

FROM ubuntu:24.04
LABEL maintainer="Qi Zheng <huaiqing.zq@antgroup.com>"

# Install SGX DCAP and PSW: the packages of the development image, in exactly
# the versions installed there (PSW and DCAP), so that the runtime cannot
# differ from the image Occlum was built
# in. The SGX SDK is not part of the runtime; the enclave's libraries come with
# the Occlum instance.
COPY --from=sgx-packages /sgx-packages /tmp/sgx-packages
RUN apt update && DEBIAN_FRONTEND="noninteractive" apt install -y --no-install-recommends wget ca-certificates jq && \
    mkdir -p /etc/apt/keyrings && \
    wget -qO /etc/apt/keyrings/intel-sgx.asc https://download.01.org/intel-sgx/sgx_repo/ubuntu/intel-sgx-deb.key && \
    echo 'deb [arch=amd64 signed-by=/etc/apt/keyrings/intel-sgx.asc] https://download.01.org/intel-sgx/sgx_repo/ubuntu noble main' | tee /etc/apt/sources.list.d/intel-sgx.list && \
    apt update && apt install -y --no-install-recommends $(cat /tmp/sgx-packages) && \
    apt clean && \
    rm -rf /var/lib/apt/lists/* /tmp/sgx-packages

# Install the files of the occlum-runtime package
COPY --from=occlum-dev \
    /opt/occlum/build/bin/occlum \
    /opt/occlum/build/bin/occlum_build.mk \
    /opt/occlum/build/bin/occlum-run \
    /opt/occlum/build/bin/occlum_exec_client \
    /opt/occlum/build/bin/occlum_exec_server \
    /opt/occlum/build/bin/

COPY docker-entrypoint.sh /usr/local/bin/

ENV PATH="/opt/occlum/build/bin:/usr/local/occlum/bin:$PATH"
# This PCCS value could be updated by env passed from user by below entrypoint
ENV PCCS_URL="https://localhost:8081/sgx/certification/v3/"
ENV USE_SECURE_CERT=true

ENTRYPOINT ["docker-entrypoint.sh"]
WORKDIR /root
CMD ["bash"]
