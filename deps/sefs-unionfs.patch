diff --git a/rcore-fs-unionfs/src/lib.rs b/rcore-fs-unionfs/src/lib.rs
index b2ebf5e..8321632 100644
--- a/rcore-fs-unionfs/src/lib.rs
+++ b/rcore-fs-unionfs/src/lib.rs
@@ -708,6 +708,9 @@ impl INode for UnionINode {
             }
         }
-        // add `name` to entry cache
-        inner.entries().insert(String::from(name), None);
+        // add `name` to entry cache, with the id of the file: a hard link has
+        // the inode number of the file
+        inner
+            .entries()
+            .insert(String::from(name), Some(Entry::File(Weak::new(), child.id)));
         Ok(())
     }
