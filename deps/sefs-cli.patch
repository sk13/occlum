diff --git a/sefs-cli/Makefile b/sefs-cli/Makefile
index f0eeb8c..56ccab9 100644
--- a/sefs-cli/Makefile
+++ b/sefs-cli/Makefile
@@ -118,7 +118,9 @@ $(App_Enclave_u_Object): app/Enclave_u.o
 	cp $(App_Enclave_u_Object) ./lib
 
 $(App_Name): $(App_Enclave_u_Object) $(App_SRC_Files)
-	@cd app && SGX_SDK=$(SGX_SDK) cargo build $(App_Rust_Flags)
+	@# Link with the system linker instead of rust-lld (the default since Rust 1.90):
+	@# rust-lld rejects the duplicate __morestack symbol of libgcc and libsgx_urts_sim.
+	@cd app && SGX_SDK=$(SGX_SDK) RUSTC_BOOTSTRAP=1 RUSTFLAGS="-C linker-features=-lld" cargo build $(App_Rust_Flags)
 	@echo "Cargo  =>  $@"
 	@mkdir -p ./bin
 	cp $(App_Rust_Path)/sefs-cli $@
diff --git a/sefs-cli/enclave/Makefile b/sefs-cli/enclave/Makefile
index 979ee76..7bc8573 100644
--- a/sefs-cli/enclave/Makefile
+++ b/sefs-cli/enclave/Makefile
@@ -11,6 +11,6 @@ ifeq ($(XARGO_SGX), 1)
 	RUST_TARGET_PATH=$(Rust_Target_Path) xargo build --target x86_64-unknown-linux-sgx --release
 	cp ./target/x86_64-unknown-linux-sgx/release/libsefsclienclave.a ../lib/libenclave.a
 else
-	cargo build --release
+	RUSTC_BOOTSTRAP=1 cargo build --release
 	cp ./target/release/libsefsclienclave.a ../lib/libenclave.a
 endif
