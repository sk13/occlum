+/// The root of a layer whose lookup of one name fails with an I/O error, as the
+/// lookup of an inode does when the disk is full
+struct FailRoot {
+    inner: Arc<dyn INode>,
+    fail_name: &'static str,
+}
+
+impl INode for FailRoot {
+    fn read_at(&self, offset: usize, buf: &mut [u8]) -> Result<usize> {
+        self.inner.read_at(offset, buf)
+    }
+    fn write_at(&self, offset: usize, buf: &[u8]) -> Result<usize> {
+        self.inner.write_at(offset, buf)
+    }
+    fn metadata(&self) -> Result<Metadata> {
+        self.inner.metadata()
+    }
+    fn create(&self, name: &str, type_: FileType, mode: u16) -> Result<Arc<dyn INode>> {
+        self.inner.create(name, type_, mode)
+    }
+    fn unlink(&self, name: &str) -> Result<()> {
+        self.inner.unlink(name)
+    }
+    fn find(&self, name: &str) -> Result<Arc<dyn INode>> {
+        if name == self.fail_name {
+            return Err(FsError::DeviceError(5));
+        }
+        self.inner.find(name)
+    }
+    fn get_entry(&self, id: usize) -> Result<String> {
+        self.inner.get_entry(id)
+    }
+    fn iterate_entries(&self, offset: usize, visitor: &mut dyn DirentVisitor) -> Result<usize> {
+        self.inner.iterate_entries(offset, visitor)
+    }
+    fn fs(&self) -> Arc<dyn FileSystem> {
+        self.inner.fs()
+    }
+    fn as_any_ref(&self) -> &dyn core::any::Any {
+        self
+    }
+}
+
+struct FailFS(Arc<FailRoot>);
+
+impl FileSystem for FailFS {
+    fn sync(&self) -> Result<()> {
+        Ok(())
+    }
+    fn root_inode(&self) -> Arc<dyn INode> {
+        self.0.clone()
+    }
+    fn info(&self) -> FsInfo {
+        Default::default()
+    }
+}
+
+/// An error of a layer is an error of the lookup, not a missing file: the name
+/// is listed by the layer, so no layer without the name must be assumed
+#[test]
+fn error_of_layer() -> Result<()> {
+    let container_fs = RamFS::new();
+    let root = container_fs.root_inode();
+    root.create("file1", FileType::File, MODE)?;
+    root.create("file2", FileType::File, MODE)?;
+    let layer = Arc::new(FailFS(Arc::new(FailRoot {
+        inner: root,
+        fail_name: "file2",
+    })));
+    let unionfs = UnionFS::new(vec![layer])?;
+    let root = unionfs.root_inode();
+
+    assert!(root.lookup("file1").is_ok());
+    assert_eq!(root.lookup("file2").err(), Some(FsError::DeviceError(5)));
+    // reading the directory (getdents) returns the entries before the name and
+    // fails at the name instead of panicking
+    let mut names: Vec<String> = Vec::new();
+    let offset = root.iterate_entries(0, &mut names)?;
+    assert_eq!(names, [".", "..", "file1"]);
+    assert_eq!(
+        root.iterate_entries(offset, &mut names).err(),
+        Some(FsError::DeviceError(5))
+    );
+    assert!(root.lookup("file3").is_not_found());
+    Ok(())
+}
+
 const MODE: u16 = 0o777;
 
