@@ -0,0 +1,233 @@
+extern crate std;
+
+use super::dev::std_impl::{StdStorage, StdUuidProvider};
+use super::dev::{File, SefsMac, Storage};
+use super::SEFS;
+use alloc::boxed::Box;
+use alloc::format;
+use alloc::string::String;
+use alloc::sync::Arc;
+use alloc::vec::Vec;
+use core::sync::atomic::{AtomicIsize, Ordering};
+use rcore_fs::dev::std_impl::StdTimeProvider;
+use rcore_fs::dev::{DevError, DevResult};
+use rcore_fs::vfs::*;
+
+const ENOSPC: i32 = 28;
+
+/// A storage whose disk can be full: writing needs `budget` bytes, a new file
+/// needs a positive budget
+struct LimitedStorage {
+    inner: StdStorage,
+    budget: Arc<AtomicIsize>,
+}
+
+struct LimitedFile {
+    inner: Box<dyn File>,
+    budget: Arc<AtomicIsize>,
+}
+
+impl Storage for LimitedStorage {
+    fn open(&self, file_id: &str) -> DevResult<Box<dyn File>> {
+        Ok(Box::new(LimitedFile {
+            inner: self.inner.open(file_id)?,
+            budget: self.budget.clone(),
+        }))
+    }
+    fn create(&self, file_id: &str) -> DevResult<Box<dyn File>> {
+        if self.budget.load(Ordering::SeqCst) <= 0 {
+            return Err(DevError(ENOSPC));
+        }
+        Ok(Box::new(LimitedFile {
+            inner: self.inner.create(file_id)?,
+            budget: self.budget.clone(),
+        }))
+    }
+    fn remove(&self, file_id: &str) -> DevResult<()> {
+        self.inner.remove(file_id)
+    }
+    fn clear(&self) -> DevResult<()> {
+        self.inner.clear()
+    }
+}
+
+impl File for LimitedFile {
+    fn read_at(&self, buf: &mut [u8], offset: usize) -> DevResult<usize> {
+        self.inner.read_at(buf, offset)
+    }
+    fn write_at(&self, buf: &[u8], offset: usize) -> DevResult<usize> {
+        let left = self.budget.fetch_sub(buf.len() as isize, Ordering::SeqCst);
+        if left < buf.len() as isize {
+            return Err(DevError(ENOSPC));
+        }
+        self.inner.write_at(buf, offset)
+    }
+    fn set_len(&self, len: usize) -> DevResult<()> {
+        if self.budget.load(Ordering::SeqCst) <= 0 {
+            return Err(DevError(ENOSPC));
+        }
+        self.inner.set_len(len)
+    }
+    fn flush(&self) -> DevResult<()> {
+        self.inner.flush()
+    }
+    fn get_file_mac(&self) -> DevResult<SefsMac> {
+        self.inner.get_file_mac()
+    }
+}
+
+fn create_fs(name: &str) -> (Arc<SEFS>, Arc<AtomicIsize>) {
+    let dir = std::env::temp_dir().join(format!("sefs-test-{}-{}", name, std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(&dir).unwrap();
+    let budget = Arc::new(AtomicIsize::new(isize::MAX / 2));
+    let device = LimitedStorage {
+        inner: StdStorage::new(&dir),
+        budget: budget.clone(),
+    };
+    let fs = SEFS::create(Box::new(device), &StdTimeProvider, &StdUuidProvider).unwrap();
+    (fs, budget)
+}
+
+fn is_no_space(e: &FsError) -> bool {
+    *e == FsError::NoDeviceSpace || *e == FsError::DeviceError(ENOSPC)
+}
+
+/// Every name of the directory that is listed can be looked up, and none is
+/// listed twice
+fn check_dir(dir: &Arc<dyn INode>) -> Vec<String> {
+    let names = dir.list().unwrap();
+    for name in names.iter() {
+        dir.find(name)
+            .unwrap_or_else(|e| panic!("{} is listed, but not found: {:?}", name, e));
+    }
+    let mut sorted = names.clone();
+    sorted.sort();
+    sorted.dedup();
+    assert_eq!(sorted.len(), names.len(), "a name is listed twice: {:?}", names);
+    names
+}
+
+/// A full disk makes creating files fail with an error, which does not leave
+/// a name of a file that is not valid, and which does not panic when the INode
+/// of the failed file is dropped. After the space is back, all works
+#[test]
+fn create_with_full_disk() {
+    let (fs, budget) = create_fs("create");
+    let root = fs.root_inode();
+    root.create("keep", FileType::File, 0o644)
+        .unwrap()
+        .write_at(0, b"kept")
+        .unwrap();
+
+    budget.store(30_000, Ordering::SeqCst);
+    let mut failed = false;
+    let mut created = 0;
+    for i in 0..1000 {
+        match root.create(&format!("f{}", i), FileType::File, 0o644) {
+            Ok(file) => {
+                if let Err(e) = file.write_at(0, &[1u8; 3000]) {
+                    assert!(is_no_space(&e), "{:?}", e);
+                    failed = true;
+                    break;
+                }
+                created += 1;
+            }
+            Err(e) => {
+                assert!(is_no_space(&e), "{:?}", e);
+                failed = true;
+                break;
+            }
+        }
+    }
+    assert!(failed, "the disk was never full");
+    assert!(created > 0);
+    // the entries before the failure are valid
+    let names = check_dir(&root);
+    assert!(names.contains(&String::from("keep")));
+    assert!(names.contains(&String::from("f0")));
+
+    // the space is back: the FS is usable and consistent
+    budget.store(isize::MAX / 2, Ordering::SeqCst);
+    root.create("after", FileType::File, 0o644).unwrap();
+    let names = check_dir(&root);
+    assert!(names.contains(&String::from("after")));
+    assert_eq!(root.lookup("keep").unwrap().read_as_vec().unwrap(), b"kept");
+    fs.sync().unwrap();
+}
+
+/// The same for directories, which also change the link count of their parent
+#[test]
+fn mkdir_with_full_disk() {
+    let (fs, budget) = create_fs("mkdir");
+    let root = fs.root_inode();
+    let nlinks_before = root.metadata().unwrap().nlinks;
+
+    budget.store(20_000, Ordering::SeqCst);
+    let mut created = 0;
+    let mut failed = false;
+    for i in 0..1000 {
+        match root.create(&format!("d{}", i), FileType::Dir, 0o755) {
+            Ok(_) => created += 1,
+            Err(e) => {
+                assert!(is_no_space(&e), "{:?}", e);
+                failed = true;
+                break;
+            }
+        }
+    }
+    assert!(failed, "the disk was never full");
+    check_dir(&root);
+    // ".." of every directory that exists is counted, not of the failed one
+    assert_eq!(root.metadata().unwrap().nlinks, nlinks_before + created);
+
+    budget.store(isize::MAX / 2, Ordering::SeqCst);
+    root.create("d_after", FileType::Dir, 0o755).unwrap();
+    assert_eq!(root.metadata().unwrap().nlinks, nlinks_before + created + 1);
+    check_dir(&root);
+    fs.sync().unwrap();
+}
+
+/// Creating a hard link with a full disk fails and leaves no entry behind, also
+/// when the entry could be written (the disk has room for it, but not for the
+/// metadata of the file that follows)
+#[test]
+fn link_with_full_disk() {
+    let (fs, budget) = create_fs("link");
+    let root = fs.root_inode();
+    let file = root.create("file", FileType::File, 0o644).unwrap();
+    file.write_at(0, b"data").unwrap();
+
+    for i in 0..5 {
+        budget.store(300, Ordering::SeqCst);
+        let e = root.link(&format!("link{}", i), &file).unwrap_err();
+        assert!(is_no_space(&e), "{:?}", e);
+    }
+    let names = check_dir(&root);
+    assert!(!names.iter().any(|n| n.starts_with("link")), "{:?}", names);
+    assert_eq!(file.metadata().unwrap().nlinks, 1);
+
+    budget.store(isize::MAX / 2, Ordering::SeqCst);
+    root.link("link_after", &file).unwrap();
+    assert_eq!(file.metadata().unwrap().nlinks, 2);
+    check_dir(&root);
+    fs.sync().unwrap();
+}
+
+/// Dropping the INode of a removed file does not need the disk to have space
+#[test]
+fn drop_with_full_disk() {
+    let (fs, budget) = create_fs("drop");
+    let root = fs.root_inode();
+    {
+        let file = root.create("file", FileType::File, 0o644).unwrap();
+        file.write_at(0, &[7u8; 5000]).unwrap();
+        root.unlink("file").unwrap();
+        budget.store(0, Ordering::SeqCst);
+        // `file` is dropped here, while the disk is full
+    }
+    // and so is the SEFS, when the last reference to it is gone
+    budget.store(0, Ordering::SeqCst);
+    drop(root);
+    drop(fs);
+}
